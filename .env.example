# Motman environment example — copy to backend/.env or export
PUBLIC_BASE_URL=https://your-host.example
CLOUD_DATABASE_URL=sqlite:///./motman_cloud.db
# CLOUD_DATABASE_URL=postgresql+psycopg://motman:motman@localhost:5432/motman
DATABASE_URL=sqlite+aiosqlite:///./motman.db
REQUIRE_DEVICE_AUTH=false
USE_DEMO_MARKET=true
ENABLE_LIVE_BINANCE=false
CORS_ORIGINS=*
TELEGRAM_BOT_TOKEN=
STALE_SECONDS_DEFAULT=120
