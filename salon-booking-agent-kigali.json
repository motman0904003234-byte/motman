            {"id": "رد_المساعد",   "displayName": "رد_المساعد",   "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true},
            {"id": "التاريخ",       "displayName": "التاريخ",       "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true}
          ]
