    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 1024, system: 'أنت مساعد حجوزات لصالون تجميل في كيغالي. اجمع: اسم العميل، الخدمة المطلوبة، الوقت المفضل. رد بإيجاز ومهنية.', messages: [{ role: 'user', content: $json.customerMessage }] }) }}",
        "options": {}
      },
      "id": "4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "🤖 Claude AI - رد مقترح",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic-api-cred",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// استخراج بيانات الخطوات السابقة\nconst resumeUrl = $execution.resumeUrl;\nconst aiResponse = $input.item.json.content[0].text;\nconst customerPhone = $('📋 استخراج بيانات العميل').item.json.customerPhone;\nconst customerMessage = $('📋 استخراج بيانات العميل').item.json.customerMessage;\nconst sandboxNumber = $('📋 استخراج بيانات العميل').item.json.sandboxNumber;\n\n// روابط الموافقة والرفض\nconst approveUrl = `${resumeUrl}?action=approve`;\nconst rejectUrl  = `${resumeUrl}?action=reject`;\n\n// بناء رسالة التيليجرام بصيغة Markdown\nconst telegramMessage = [\n  '🔔 *طلب حجز جديد - صالون كيغالي*',\n  '',\n  `📱 *رقم العميل:* \\`${customerPhone}\\``,\n  `💬 *رسالة العميل:*`,\n  customerMessage,\n  '',\n  '🤖 *الرد المقترح من Claude:*',\n  aiResponse,\n  '',\n  '─────────────────────',\n  `✅ [موافقة وإرسال الرد](${approveUrl})`,\n  `❌ [رفض وإلغاء](${rejectUrl})`\n].join('\\n');\n\nreturn [{\n  json: {\n    telegramMessage,\n    aiResponse,\n    customerPhone,\n    customerMessage,\n    sandboxNumber,\n    approveUrl,\n    rejectUrl\n  }\n}];"
      },
      "id": "5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
      "name": "✍️ تحضير رسالة المراجعة",
