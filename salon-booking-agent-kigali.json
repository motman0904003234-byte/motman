      },
      "id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
      "name": "⏳ انتظار موافقة صاحب الصالون",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1540, 400],
      "webhookId": "8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-approve",
              "leftValue": "={{ $json.query.action }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3f",
      "name": "✅ هل تمت الموافقة؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1800, 400]
    },
    {
      "parameters": {
        "jsCode": "// استخراج البيانات المنظمة من رد Claude\nconst aiResponse = $('✍️ تحضير رسالة المراجعة').item.json.aiResponse;\nconst customerPhone = $('✍️ تحضير رسالة المراجعة').item.json.customerPhone;\nconst customerMessage = $('✍️ تحضير رسالة المراجعة').item.json.customerMessage;\n\n// محاولة استخراج الاسم والخدمة والوقت من رد المساعد\nconst extractField = (text, patterns) => {\n  for (const pattern of patterns) {\n    const match = text.match(pattern);\n    if (match) return match[1].trim();\n  }\n  return 'يحتاج مراجعة';\n};\n\nconst name = extractField(aiResponse, [\n  /اسم[ك\\s]*:?\\s*([^\\n،,]+)/i,\n  /الاسم[\\s]*:?\\s*([^\\n،,]+)/i\n]);\n\nconst service = extractField(aiResponse, [\n  /الخدمة[\\s]*:?\\s*([^\\n،,]+)/i,\n  /خدمة[\\s]*:?\\s*([^\\n،,]+)/i,\n  /طلب[تي]?[\\s]*:?\\s*([^\\n،,]+)/i\n]);\n\nconst time = extractField(aiResponse, [\n  /الوقت[\\s]*:?\\s*([^\\n،,]+)/i,\n  /موعد[\\s]*:?\\s*([^\\n،,]+)/i,\n  /يوم[\\s]*:?\\s*([^\\n،,]+)/i\n]);\n\nconst now = new Date().toLocaleString('ar-EG', { timeZone: 'Africa/Kigali' });\n\nreturn [{\n  json: {\n    name,\n    service,\n    time,\n    status: 'مؤكد ✅',\n    customerPhone: customerPhone.replace('whatsapp:', ''),\n    customerMessage,\n    aiResponse,\n    timestamp: now\n  }\n}];"
      },
